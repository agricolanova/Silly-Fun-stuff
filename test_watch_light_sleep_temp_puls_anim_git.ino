void readPulse() {                    // for pulse reading
  if (!pulseSensorOK) return;
  long irValue = max3010x.getIR();
  long redValue = max3010x.getRed();
  if (checkForBeat(irValue)) {
    long delta = millis() - lastBeat;
    lastBeat = millis();
    bpm = 60 / (delta / 1000.0);
    if (bpm > 20 && bpm < 255) {
      rates[rateSpot++] = (byte)bpm;
      rateSpot %= RATE_SIZE;
      bpmAvg = 0;
      for (byte i = 0; i < RATE_SIZE; i++) {
        bpmAvg += rates[i];
      }
      bpmAvg /= RATE_SIZE;
    }
    
}

if (checkForBeat(irValue)) {
  long delta = millis() - lastBeat;
  lastBeat = millis();
  bpm = 60 / (delta / 1000.0);
  if (bpm > 20 && bpm < 255) {
    rates[rateSpot++] = (byte)bpm;
    rateSpot %= RATE_SIZE;
    bpmAvg = 0;
    for (byte i = 0; i < RATE_SIZE; i++) {
      bpmAvg += rates[i];
    }
    bpmAvg /= RATE_SIZE;
  }
}
// --- SpO2 Berechnung (einfaches Modell) ---
if (irValue > 50000 && redValue > 50000) {
  float ratio = (float)redValue / (float)irValue;
  SpO2 = 110 - 25 * ratio;
  if (SpO2 > 100) SpO2 = 100;
  if (SpO2 < 0) SpO2 = 0;
}
  
}



